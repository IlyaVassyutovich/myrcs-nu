{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#89B4FA",
    "closer": "p:os",
    "lavender": "#B4BEFE",
    "os": "#ACB0BE",
    "pink": "#F5C2E7"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "foreground",
    "template": "\uf105 ",
    "newline": true
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "path",
          "properties": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": "╓ {{ .Path }}",
          "foreground": "p:pink",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "session",
          "template": "{{ .UserName }}",
          "foreground": "p:blue",
          "style": "plain"
        },
        {
          "type": "text",
          "template": " on ",
          "foreground": "p:darkBlue",
          "style": "plain"
        },
        {
          "type": "os",
          "template": "{{.Icon}} ",
          "foreground": "p:os",
          "style": "plain"
        },
        {
          "type": "session",
          "template": "{{ .HostName }}",
          "foreground": "p:blue",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "git",
          "properties": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "╟ {{ .HEAD }}",
          "foreground": "p:lavender",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "project",
          "style": "plain",
          "template": "╟ {{ if .Error }}{{ .Error }}{{ else }}{{ if .Name }}\udb80\udfd6 {{ .Name }}{{ end }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "template": "╚\uf105",
          "foreground": "p:closer",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}